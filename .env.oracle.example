# Copy to .env and fill in values (never commit .env).
#   copy .env.oracle.example .env

# -----------------------------------------------------------------------------
# Ollama (required)
# -----------------------------------------------------------------------------
OLLAMA_MODEL=qwen2.5-coder:latest

# Local Ollama (default)
OLLAMA_HOST=http://127.0.0.1:11434

# Remote Ollama via ngrok or reverse proxy (uncomment and set your URL)
# OLLAMA_HOST=https://your-subdomain.ngrok-free.dev

# Set both when the Ollama endpoint is behind HTTP Basic Auth
OLLAMA_BASIC_AUTH_USER=
OLLAMA_BASIC_AUTH_PASSWORD=

# -----------------------------------------------------------------------------
# Oracle database (required for run_sql)
# -----------------------------------------------------------------------------
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_HOST=192.168.0.1
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=PDBORCL

# Optional: full DSN override (if set, ORACLE_HOST/PORT/SERVICE_NAME are ignored)
# ORACLE_DSN=192.168.0.1:1521/PDBORCL
# ORACLE_SID=ORCL

# -----------------------------------------------------------------------------
# ChromaDB agent memory (required)
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=atfm-oracle

# train.py clears this collection then re-seeds (safe to re-run). Delete ./chroma_db only to reset all collections or change CHROMA_COLLECTION_NAME.

# -----------------------------------------------------------------------------
# SQL access control (optional; comma-separated, case-insensitive)
# -----------------------------------------------------------------------------
# ATFM flight tables (this project's default schema)
ALLOWED_TABLES=T_FINISHED_FLIGHTS,T_DAY_FLIGHTS

# Optional column allowlist; if unset, defaults from schema_context.py apply
# ALLOWED_COLUMNS=FLIGHTNBR,FLIGHTDATE,FROM_AIRP,TO_AIRP,ETD,ETA,VIA,ATD,ATA

# Sample Chinook-style demo tables (uncomment if using that schema instead)
# ALLOWED_TABLES=Album,Artist,Customer,Employee,Genre,Invoice,InvoiceLine,MediaType,Playlist,PlaylistTrack,Track

# -----------------------------------------------------------------------------
# Web UI
# -----------------------------------------------------------------------------
SPEECH_RECOGNITION_LANG=vi-VN

# AI activity report API: GET /api/reports/ai
# Required unless application-wide Basic Auth is configured. Clients send X-API-Key.
REPORT_API_KEY=

# Comma-separated browser origins allowed to call the report API from another site.
# Leave empty for same-origin access only. Do not use * with credentialed requests.
# REPORT_API_CORS_ORIGINS=https://reports.example.com,http://localhost:3000

# One JSONL record per user question, used by the AI report API.
AI_REPORT_ENABLED=true
AI_REPORT_LOG_FILE=logs/ai_report.jsonl

# Stores the final AI answer in the report. Questions and generated SQL are always stored.
# Set false when response contents must not be retained.
AI_REPORT_INCLUDE_RESPONSE_TEXT=true

# Optional: protect the FastAPI app with HTTP Basic Auth
# APP_BASIC_AUTH_USER=
# APP_BASIC_AUTH_PASSWORD=

# -----------------------------------------------------------------------------
# Application logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FILE_MAX_BYTES=5242880
LOG_FILE_BACKUP_COUNT=3

# Set LOG_FILE empty to log to stderr only
# LOG_FILE=

# -----------------------------------------------------------------------------
# Audit logging (optional)
# -----------------------------------------------------------------------------
AUDIT_ENABLED=true
AUDIT_LOG_FILE=logs/audit.jsonl
AUDIT_LOG_TOOL_ACCESS_CHECKS=true
AUDIT_LOG_TOOL_INVOCATIONS=true
AUDIT_LOG_TOOL_RESULTS=true
AUDIT_LOG_UI_FEATURE_CHECKS=false
AUDIT_LOG_AI_RESPONSES=true
AUDIT_INCLUDE_FULL_AI_RESPONSES=false
AUDIT_SANITIZE_TOOL_PARAMETERS=true

# -----------------------------------------------------------------------------
# Human-in-the-loop training (optional)
# -----------------------------------------------------------------------------
# When true, successful run_sql results require user approval before Chroma save.
# All users see thumbs up/down; only admins commit to persistent memory.
HITL_ENABLED=true
HITL_FEEDBACK_LOG_FILE=logs/feedback.jsonl
